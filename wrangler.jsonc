{
  "name": "itstyleryip",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "itstyleryip.com",
      "custom_domain": true
    },
    {
      "pattern": "www.itstyleryip.com",
      "custom_domain": true
    }
  ]
}
